# Optional: enables LLM-assisted job parsing, match narratives, and answer
# drafting. Without this, AutoApplier still works using a deterministic engine.
# Get a key from the Vercel AI Gateway (https://vercel.com/docs/ai-gateway).
AI_GATEWAY_API_KEY=

# Model used when a key is present.
AI_MODEL=anthropic/claude-sonnet-5

# Optional: password gate for the whole app. Leave UNSET for local dev (the
# app is then wide open, which is what you want on your own machine). Set it on
# a deployment you want to keep private (e.g. testing on Vercel) and every page
# and API route will require signing in with this password at /login.
APP_PASSWORD=

# Optional: signing key for the login session cookie. Set any long random
# string. If unset, APP_PASSWORD is used to sign sessions. Setting a dedicated
# secret lets you invalidate all sessions by rotating it without changing the
# password.
AUTH_SECRET=

# Optional: secret the Vercel cron uses to authenticate /api/cron/fetch.
# Set the same value in your Vercel project env. If unset, the cron endpoint is
# open (fine for local dev).
CRON_SECRET=

# Optional: Postgres/Neon connection string. When set, the app persists to
# Postgres instead of JSON files — required for a real (multi-instance,
# non-ephemeral) deployment. Provision Neon from the Vercel Marketplace.
# DATABASE_URL=postgres://user:pass@host/db

# Optional: override where the local JSON store writes (defaults to ./data,
# or /tmp/autoapplier-data on Vercel's read-only filesystem). Ignored when
# DATABASE_URL is set.
# AUTOAPPLIER_DATA_DIR=
