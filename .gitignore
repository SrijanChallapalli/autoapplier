# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# local data store (personal info — never commit)
# Ignore everything under data/ (json plus atomic-write *.tmp files) except the
# .gitkeep placeholder that keeps the directory in the repo.
/data/*
!/data/.gitkeep

# env
.env
.env*.local

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
*.tsbuildinfo
